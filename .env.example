# Environment Configuration
# Copy this file to .env and update values

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_ids

# Application
DEBUG=true
APP_NAME=Phal
APP_VERSION=1.0.0

# Detection thresholds (adjust based on your needs)
ANOMALY_THRESHOLD=-0.5
AUTOENCODER_THRESHOLD=0.1
CONFIDENCE_THRESHOLD=0.7
